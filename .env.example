# 复制成 .env 再填。同名环境变量优先于这个文件。只有 crossfire/config.py 读它。

# Claude 调用（提取主张、两两比对、最终判断）。verify 的 live 和 cached 都要。
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Steel 云端浏览器实时抓取网页。verify --mode live 和 prefetch 要；cached 和只看历史结果不要。
STEEL_API_KEY=your_steel_api_key_here

# 三个步骤各用哪个模型，不填默认 claude-sonnet-4-6。
# MODEL_EXTRACT=claude-sonnet-4-6
# MODEL_PAIR=claude-sonnet-4-6
# MODEL_JUDGE=claude-sonnet-4-6

# 两两比对用哪种实现。现在只有 claude。
# PAIRER=claude

# 结果文件、页面缓存、问题清单放在哪。相对路径相对项目根目录。
# CROSSFIRE_RUNS_DIR=out/runs
# CROSSFIRE_CACHE_DIR=out/cache
# CROSSFIRE_QUESTIONS_FILE=questions/demo.yaml

# 评测集（题目和冻结快照）放在哪，评测跑出来的结果放在哪（和 out/runs 的历史分开）。
# CROSSFIRE_EVALS_DIR=evals
# CROSSFIRE_EVAL_RUNS_DIR=out/eval-runs

# 评测集（题目和冻结快照）放在哪，评测跑出来的结果放在哪（和 out/runs 的历史分开）。
# CROSSFIRE_EVALS_DIR=evals
# CROSSFIRE_EVAL_RUNS_DIR=out/eval-runs
