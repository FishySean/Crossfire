# 复制成 .env 再填。同名环境变量优先于这个文件。只有 crossfire/config.py 读它。

# Claude 调用（提取主张、两两比对、最终判断）。verify 的 live 和 cached 都要。
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Steel 云端浏览器实时抓取网页。verify --mode live 和 prefetch 要；cached 和只看历史结果不要。
STEEL_API_KEY=your_steel_api_key_here

# 三个步骤各用哪个模型，不填默认 claude-sonnet-4-6。
# MODEL_EXTRACT=claude-sonnet-4-6
# MODEL_PAIR=claude-sonnet-4-6
# MODEL_JUDGE=claude-sonnet-4-6

# 两两比对用哪种实现：claude（默认，调 API）或 nli（本地模型，免费）。
# PAIRER=claude
# PAIRER=nli
# NLI 模型：Hugging Face 仓库名，或本地目录（开发覆盖）。
# NLI_MODEL=FishySean/crossfire-pairer
# 默认已锁定到 config.DEFAULT_NLI_MODEL_REVISION；一般不用改。
# NLI_MODEL_REVISION=0517c59dfa13038226b4b66c3fa6b605b9215df5
# 本地开发可覆盖为目录：
# NLI_MODEL=models/crossfire-pairer-v1
# NLI_BATCH_SIZE=16

# 同时提取几页。每页的 prompt 有上万 token，太高容易撞上账户每分钟 token 限额。
# CROSSFIRE_EXTRACT_CONCURRENCY=4

# 自己提问单题费用上限（美元）。估算超过就不跑。默认 1。
# MAX_COST_PER_QUESTION=1.0
# 用户问过的题存哪（不进 git）。
# CROSSFIRE_USER_QUESTIONS_DIR=questions/user

# 结果文件、页面缓存、问题清单放在哪。相对路径相对项目根目录。
# CROSSFIRE_RUNS_DIR=out/runs
# CROSSFIRE_CACHE_DIR=out/cache
# CROSSFIRE_QUESTIONS_FILE=questions/demo.yaml

# 评测集（题目和冻结快照）放在哪，评测跑出来的结果放在哪（和 out/runs 的历史分开）。
# CROSSFIRE_EVALS_DIR=evals
# CROSSFIRE_EVAL_RUNS_DIR=out/eval-runs
# CROSSFIRE_CONSISTENCY_DIR=out/consistency

# 题库文件和审查报告。
# CROSSFIRE_BANK_FILE=questions/bank.yaml
# CROSSFIRE_BANK_REVIEW_FILE=notes/bank-review.md
